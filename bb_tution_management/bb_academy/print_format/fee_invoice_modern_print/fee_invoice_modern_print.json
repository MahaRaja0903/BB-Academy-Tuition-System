 "font_size": 14,
 "html": "<style>\r\n    .invoice-wrapper {\r\n        font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;\r\n        color: #1f2937;\r\n        margin: 0 auto;\r\n        padding: 40px;\r\n        background: #ffffff;\r\n        border: 1px solid #e5e7eb;\r\n        border-radius: 12px;\r\n        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);\r\n        max-width: 800px;\r\n    }\r\n    .header-section {\r\n        border-bottom: 2px solid #e5e7eb;\r\n        padding-bottom: 20px;\r\n        margin-bottom: 20px;\r\n    }\r\n    .brand-title {\r\n        font-size: 28px;\r\n        font-weight: 800;\r\n        color: #111827;\r\n        margin: 0;\r\n        letter-spacing: -0.5px;\r\n    }\r\n    .brand-subtitle {\r\n        font-size: 14px;\r\n        color: #6b7280;\r\n        margin-top: 4px;\r\n        font-weight: 500;\r\n    }\r\n    .invoice-label {\r\n        font-size: 11px;\r\n        text-transform: uppercase;\r\n        color: #6b7280;\r\n        letter-spacing: 1px;\r\n        font-weight: 600;\r\n        margin-bottom: 4px;\r\n    }\r\n    .invoice-value {\r\n        font-size: 15px;\r\n        font-weight: 600;\r\n        color: #1f2937;\r\n    }\r\n    .info-grid {\r\n        display: table;\r\n        width: 100%;\r\n        margin-bottom: 30px;\r\n        table-layout: fixed;\r\n    }\r\n    .info-column {\r\n        display: table-cell;\r\n        width: 50%;\r\n        vertical-align: top;\r\n    }\r\n    .info-box {\r\n        background: #f9fafb;\r\n        padding: 20px;\r\n        border-radius: 8px;\r\n        border: 1px solid #f3f4f6;\r\n        margin-right: 10px;\r\n    }\r\n    .info-box.right {\r\n        margin-right: 0;\r\n        margin-left: 10px;\r\n    }\r\n    .info-row {\r\n        margin-bottom: 12px;\r\n    }\r\n    .info-row:last-child {\r\n        margin-bottom: 0;\r\n    }\r\n    \r\n    .payment-summary {\r\n        margin-top: 30px;\r\n        border: 1px solid #e5e7eb;\r\n        border-radius: 8px;\r\n        overflow: hidden;\r\n    }\r\n    .summary-header {\r\n        background: #f9fafb;\r\n        padding: 15px 20px;\r\n        border-bottom: 1px solid #e5e7eb;\r\n        font-weight: 700;\r\n        color: #374151;\r\n        font-size: 16px;\r\n    }\r\n    .summary-body {\r\n        padding: 20px;\r\n    }\r\n    \r\n    .amount-row {\r\n        display: table;\r\n        width: 100%;\r\n        margin-bottom: 15px;\r\n        padding-bottom: 15px;\r\n        border-bottom: 1px dashed #e5e7eb;\r\n    }\r\n    .amount-row:last-child {\r\n        margin-bottom: 0;\r\n        padding-bottom: 0;\r\n        border-bottom: none;\r\n    }\r\n    .amount-label {\r\n        display: table-cell;\r\n        font-size: 15px;\r\n        color: #4b5563;\r\n        font-weight: 500;\r\n        vertical-align: middle;\r\n    }\r\n    .amount-value {\r\n        display: table-cell;\r\n        text-align: right;\r\n        font-size: 18px;\r\n        font-weight: 700;\r\n        color: #111827;\r\n        vertical-align: middle;\r\n    }\r\n    .amount-value.balance {\r\n        color: #dc2626;\r\n    }\r\n    .amount-value.paid {\r\n        color: #059669;\r\n    }\r\n    \r\n    .terms-section {\r\n        margin-top: 40px;\r\n        padding-top: 20px;\r\n        border-top: 2px solid #e5e7eb;\r\n    }\r\n    .terms-title {\r\n        font-size: 14px;\r\n        font-weight: 700;\r\n        color: #374151;\r\n        margin-bottom: 10px;\r\n    }\r\n    .terms-content {\r\n        font-size: 12px;\r\n        color: #6b7280;\r\n        line-height: 1.6;\r\n    }\r\n    .content-wrapper {\r\n        position: relative;\r\n        z-index: 1;\r\n    }\r\n    .badge {\r\n        display: inline-block;\r\n        padding: 4px 12px;\r\n        border-radius: 9999px;\r\n        font-size: 12px;\r\n        font-weight: 600;\r\n        background: #e5e7eb;\r\n        color: #374151;\r\n    }\r\n    .badge-paid { background: #d1fae5; color: #065f46; }\r\n    .badge-unpaid { background: #fee2e2; color: #991b1b; }\r\n    .badge-partial { background: #fef3c7; color: #92400e; }\r\n    \r\n    /* Frappe specific hides for print formatting */\r\n    .print-format {\r\n        background-color: transparent !important;\r\n        box-shadow: none !important;\r\n    }\r\n</style>\r\n\r\n{% set is_starting = 1 if doc.is_starting_fee or doc.fee_month == \"Starting Payment\" else 0 %}\r\n{% set invoice_date = doc.invoice_date or doc.creation %}\r\n{% set invoice_day = frappe.utils.get_datetime(invoice_date).strftime(\"%A\") if invoice_date else \"\" %}\r\n{% set display_date = frappe.utils.formatdate(invoice_date) %}\r\n\r\n<div class=\"invoice-wrapper\">\r\n    <div class=\"content-wrapper\">\r\n        <div style=\"display: table; width: 100%; border-bottom: 2px solid #e5e7eb; padding-bottom: 20px; margin-bottom: 30px;\">\r\n            <div style=\"display: table-cell; vertical-align: middle;\">\r\n                <h1 class=\"brand-title\">BB ACADEMY</h1>\r\n                <div class=\"brand-subtitle\">Tuition Center Management</div>\r\n            </div>\r\n            <div style=\"display: table-cell; text-align: right; vertical-align: middle;\">\r\n                <h2 style=\"margin: 0; color: #374151; font-size: 24px; font-weight: 700; text-transform: uppercase;\">\r\n                    {% if is_starting %}Starting Payment Receipt{% else %}Fee Receipt{% endif %}\r\n                </h2>\r\n                <div style=\"margin-top: 8px;\">\r\n                    <span class=\"badge badge-{% if doc.outstanding_amount <= 0 %}paid{% elif doc.paid_amount > 0 %}partial{% else %}unpaid{% endif %}\">\r\n                        {{ doc.status or 'Draft' }}\r\n                    </span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"info-grid\">\r\n            <div class=\"info-column\">\r\n                <div class=\"info-box\">\r\n                    <div class=\"info-row\">\r\n                        <div class=\"invoice-label\">Invoice No</div>\r\n                        <div class=\"invoice-value\">{{ doc.name }}</div>\r\n                    </div>\r\n                    <div class=\"info-row\">\r\n                        <div class=\"invoice-label\">Date</div>\r\n                        <div class=\"invoice-value\">{{ display_date }}</div>\r\n                    </div>\r\n                    <div class=\"info-row\">\r\n                        <div class=\"invoice-label\">Day</div>\r\n                        <div class=\"invoice-value\">{{ invoice_day }}</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"info-column\">\r\n                <div class=\"info-box right\">\r\n                    <div class=\"info-row\">\r\n                        <div class=\"invoice-label\">Student Name</div>\r\n                        <div class=\"invoice-value\">{{ doc.student_name }}</div>\r\n                    </div>\r\n                    <div class=\"info-row\">\r\n                        <div style=\"display: table; width: 100%; table-layout: fixed;\">\r\n                            <div style=\"display: table-cell; width: 50%;\">\r\n                                <div class=\"invoice-label\">Standard</div>\r\n                                <div class=\"invoice-value\">{{ doc.standard }}</div>\r\n                            </div>\r\n                            <div style=\"display: table-cell; width: 50%;\">\r\n                                <div class=\"invoice-label\">Batch</div>\r\n                                <div class=\"invoice-value\">{{ doc.batch }}</div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"payment-summary\">\r\n            <div class=\"summary-header\">\r\n                Payment Details\r\n            </div>\r\n            <div class=\"summary-body\">\r\n                <div class=\"amount-row\">\r\n                    <div class=\"amount-label\">\r\n                        {% if is_starting %}\r\n                            Starting Payment Covers\r\n                            <div style=\"font-size: 13px; color: #6b7280; margin-top: 4px;\">(1st Month, Last Month & Admission Fees)</div>\r\n                        {% else %}\r\n                            Fees Amount Paid For The Month of\r\n                        {% endif %}\r\n                    </div>\r\n                    <div class=\"amount-value\" style=\"font-size: 16px; color: #374151;\">\r\n                        {% if is_starting %}\r\n                            Admission & Deposit\r\n                        {% else %}\r\n                            {{ doc.fee_month }}\r\n                        {% endif %}\r\n                    </div>\r\n                </div>\r\n                \r\n                <div class=\"amount-row\">\r\n                    <div class=\"amount-label\">\r\n                        {% if is_starting %}\r\n                            Starting Payment Amount Paid\r\n                        {% else %}\r\n                            Fees Amount Paid\r\n                        {% endif %}\r\n                    </div>\r\n                    <div class=\"amount-value paid\">\r\n                        {{ doc.currency or '\u20b9' }} {{ frappe.utils.fmt_money(doc.paid_amount or 0) }}\r\n                    </div>\r\n                </div>\r\n                \r\n                <div class=\"amount-row\">\r\n                    <div class=\"amount-label\">\r\n                        {% if is_starting %}\r\n                            Starting Payment Balance Amount\r\n                        {% else %}\r\n                            Balance Amount\r\n                        {% endif %}\r\n                    </div>\r\n                    <div class=\"amount-value balance\">\r\n                        {{ doc.currency or '\u20b9' }} {{ frappe.utils.fmt_money(doc.outstanding_amount or 0) }}\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"terms-section\">\r\n            <div class=\"terms-title\">Terms and Conditions</div>\r\n            <div class=\"terms-content\">\r\n                1. Fees once paid are non-refundable under any circumstances.<br>\r\n                2. Monthly fees must be paid on or before the due date to avoid late payment penalties.<br>\r\n                3. Please keep this receipt safely for your records and future reference.<br>\r\n                4. Starting payments cover admission fees and specific month deposits as discussed at the time of enrollment.\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n",
