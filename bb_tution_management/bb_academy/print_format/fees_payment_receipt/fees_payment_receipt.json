 "font_size": 14,
 "html": "\n<style>\n    .receipt-container {\n        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n        color: #333;\n        margin: 0;\n        padding: 20px;\n    }\n    .receipt-header {\n        text-align: center;\n        border-bottom: 2px dashed #ccc;\n        padding-bottom: 20px;\n        margin-bottom: 20px;\n    }\n    .receipt-header h1 {\n        color: #28a745;\n        margin: 0;\n        font-size: 28px;\n        text-transform: uppercase;\n        letter-spacing: 2px;\n    }\n    .receipt-header h3 {\n        margin: 5px 0 0 0;\n        color: #555;\n    }\n    .info-card {\n        background-color: #f9f9f9;\n        padding: 15px;\n        border-radius: 8px;\n        border: 1px solid #eee;\n        margin-bottom: 10px;\n    }\n    .info-card table {\n        width: 100%;\n    }\n    .info-card td {\n        padding: 8px 0;\n    }\n    .info-card .label {\n        color: #666;\n        font-size: 0.9em;\n        text-transform: uppercase;\n        width: 40%;\n    }\n    .info-card .val {\n        font-weight: bold;\n        color: #333;\n        text-align: right;\n    }\n    .amount-box {\n        text-align: center;\n        background-color: #e8f5e9;\n        border: 2px solid #4caf50;\n        border-radius: 10px;\n        padding: 20px;\n        margin: 30px 0;\n    }\n    .amount-box h2 {\n        color: #2e7d32;\n        margin: 0;\n        font-size: 36px;\n    }\n    .amount-box p {\n        margin: 5px 0 0 0;\n        color: #555;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n    }\n    .footer-notes {\n        margin-top: 40px;\n        text-align: center;\n        color: #777;\n        font-size: 0.9em;\n        border-top: 1px solid #eee;\n        padding-top: 20px;\n    }\n</style>\n\n<div class=\"receipt-container\">\n    <div class=\"receipt-header\">\n        <h1>PAYMENT RECEIPT</h1>\n        <h3>BB Academy</h3>\n    </div>\n\n    <div class=\"row\">\n        <div class=\"col-xs-6\">\n            <div class=\"info-card\">\n                <table>\n                    <tr><td class=\"label\">Receipt No:</td><td class=\"val\">{{ doc.name }}</td></tr>\n                    <tr><td class=\"label\">Date:</td><td class=\"val\">{{ frappe.utils.formatdate(doc.payment_date) }}</td></tr>\n                    <tr><td class=\"label\">Payment Mode:</td><td class=\"val\">{{ doc.payment_mode }}</td></tr>\n                    <tr><td class=\"label\">Invoice Ref:</td><td class=\"val\">{{ doc.fee_invoice }}</td></tr>\n                </table>\n            </div>\n        </div>\n        <div class=\"col-xs-6\">\n            <div class=\"info-card\">\n                <table>\n                    <tr><td class=\"label\">Student ID:</td><td class=\"val\">{{ doc.student }}</td></tr>\n                    <tr><td class=\"label\">Name:</td><td class=\"val\">{{ doc.student_name }}</td></tr>\n                </table>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"amount-box\">\n        <p>Amount Received</p>\n        <h2>{{ doc.currency or '\u20b9' }} {{ frappe.utils.fmt_money(doc.amount) }}</h2>\n    </div>\n\n    {% if doc.discount_amount or doc.tax_amount %}\n    <div class=\"row\">\n        <div class=\"col-xs-12\">\n            <table style=\"width: 100%; border-collapse: collapse; margin-top: 20px;\">\n                {% if doc.discount_amount %}\n                <tr>\n                    <td style=\"padding: 10px; border-bottom: 1px solid #eee;\">Discount Applied:</td>\n                    <td style=\"padding: 10px; border-bottom: 1px solid #eee; text-align: right; color: #d32f2f;\">\n                        - {{ doc.currency or '\u20b9' }} {{ frappe.utils.fmt_money(doc.discount_amount) }}\n                    </td>\n                </tr>\n                {% endif %}\n                {% if doc.tax_amount %}\n                <tr>\n                    <td style=\"padding: 10px; border-bottom: 1px solid #eee;\">Tax (GST):</td>\n                    <td style=\"padding: 10px; border-bottom: 1px solid #eee; text-align: right;\">\n                        + {{ doc.currency or '\u20b9' }} {{ frappe.utils.fmt_money(doc.tax_amount) }}\n                    </td>\n                </tr>\n                {% endif %}\n                {% if doc.discount_amount or doc.tax_amount %}\n                <tr>\n                    <td style=\"padding: 10px; font-weight: bold;\">Grand Total:</td>\n                    <td style=\"padding: 10px; text-align: right; font-weight: bold;\">\n                        {{ doc.currency or '\u20b9' }} {{ frappe.utils.fmt_money(doc.grand_total) }}\n                    </td>\n                </tr>\n                {% endif %}\n            </table>\n        </div>\n    </div>\n    {% endif %}\n\n    <div class=\"footer-notes\">\n        <p>Thank you for your payment!</p>\n        <p>This is a computer-generated receipt and does not require a signature.</p>\n    </div>\n</div>\n",
